{
	"name": "progressive",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"format": "biome format --write . && biome check --write .",
		"dev:client": "pnpm --filter @progressive/client dev",
		"build:client": "pnpm --filter @progressive/client build",
		"preview:client": "pnpm --filter @progressive/client preview",
		"dev:api": "pnpm --filter @progressive/api dev",
		"build:api": "pnpm --filter @progressive/api build",
		"start:api": "pnpm --filter @progressive/client start",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": [
			"biome check --write "
		]
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.8.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0"
	}
}
