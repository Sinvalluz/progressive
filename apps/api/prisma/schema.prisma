generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @db.Uuid
  email String @unique
  name String
  password String
  role Role
  imgUrl String?
  createdAt DateTime
  updatedAt DateTime

  @@map("users")
}

model RegistrationToken {
  id String @id @db.Uuid
  token String

  @@map("registration_tokens")
}

model Equipment {
  id String @id @db.Uuid
  name String @unique
  createdAt DateTime
  updatedAt DateTime

  @@map("equipments")
}

model MuscleGroup {
  id String @id @db.Uuid
  name String @unique
  createdAt DateTime
  updatedAt DateTime

  @@map("muscle_groups")
}

enum Role {
  USER
  ADMIN
}